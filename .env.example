# Only needed to run the CLIs from your own machine (stories-enqueue, stories-bot).
# In GitHub Actions these come from Secrets. Never commit a real .env file (it is git-ignored).
IG_USER_ID=
IG_ACCESS_TOKEN=
# "instagram" when the token comes from Instagram Login (no Facebook Page); empty otherwise.
IG_API=

# Cloudflare R2 bucket that hosts the arts (S3-compatible API token with Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://media.your-domain.com
R2_PUBLIC_URL=

# Optional: Telegram bot for receiving arts and for alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
